{
  "name": "notification-microservice",
  "version": "1.0.0",
  "description": "A microservice for handling notifications",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc && tsc-alias",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "lint": "eslint --ext .ts,.js .",
    "migrations:create": "npx ts-node ./src/infrastructure/database/scripts/create-migration-file-script.ts",
    "prepare": "husky",
    "start": "node dist/server.js",
    "start:dev": "nodemon",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src/**/*"
    ],
    "ext": "ts,js,json,yml",
    "ignore": [
      "node_modules/**/*",
      "dist/**/*",
      "coverage/**/*"
    ],
    "exec": "tsx watch ./src/server.ts",
    "env": {
      "NODE_ENV": "development"
    },
    "restartable": "rs"
  },
  "keywords": [
    "microservice"
  ],
  "homepage": "https://github.com/kvngdre/node-notification-microservice#README",
  "author": "John Kennedy Kalu",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "inversify": "^7.11.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "typeorm": "^0.3.28",
    "ulid": "^2.3.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.16.0",
    "@types/sinon": "^21.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "nock": "^14.0.10",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.1",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2",
    "testcontainers": "^11.11.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17"
  }
}
